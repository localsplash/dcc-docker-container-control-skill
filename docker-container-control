#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time

OPT_ROOT = os.environ.get('OPT_ROOT', '/opt')
COMPOSE_NAMES = ['docker-compose.clawdydaapps.yml', 'docker-compose.yml', 'compose.yml', 'compose.yaml']


def usage(exit_code=2):
    print(
        'Usage: sudo /opt/docker-container-control <list|status|stop|restart|recreate|deploy|dry-run> [name]\n\n'
        'Names are discovered from Docker compose labels and compose files under /opt.\n'
        'Use the folder-style name, compose project name, or running container name.\n'
        'A folder\'s .env COMPOSE_FILE (and COMPOSE_PATH_SEPARATOR) picks its Compose files,\n'
        'as it does for docker compose itself.\n\n'
        '  list              Show detected deployments.\n'
        '  status <name>     Show compose status for one deployment.\n'
        '  stop <name>       docker compose stop for the deployment.\n'
        '  restart <name>    docker compose restart for the deployment.\n'
        '  recreate <name>   docker compose up -d --build --force-recreate.\n'
        '  deploy <name>     git pull --ff-only when applicable, pull images, build, restart.\n'
        '  dry-run <name>    Show what deploy would run without changing containers.',
        file=sys.stderr,
    )
    raise SystemExit(exit_code)


def fail(message, exit_code=2):
    print(f'ERROR: {message}', file=sys.stderr)
    usage(exit_code)


def run(args, cwd=None, check=False, capture=True, env=None):
    kwargs = {'cwd': cwd, 'text': True, 'env': env}
    if capture:
        kwargs.update({'stdout': subprocess.PIPE, 'stderr': subprocess.PIPE})
    proc = subprocess.run(args, **kwargs)
    if check and proc.returncode != 0:
        if capture:
            if proc.stdout:
                print(proc.stdout, end='')
            if proc.stderr:
                print(proc.stderr, end='', file=sys.stderr)
        raise subprocess.CalledProcessError(proc.returncode, args)
    return proc


def git_args(folder, *args):
    """git for a checkout this process does not own.

    The deployments under /opt belong to the account that develops them, not to
    root, and git refuses a repository whose owner differs ("dubious
    ownership"). Trust exactly the folder being deployed, rather than adding
    entries to root's global config.
    """
    return ['git', '-c', f'safe.directory={os.path.abspath(folder)}', '-C', folder, *args]


def compose_base():
    if run(['docker', 'compose', 'version'], capture=True).returncode == 0:
        return ['docker', 'compose']
    if run(['docker-compose', '--version'], capture=True).returncode == 0:
        return ['docker-compose']
    fail('docker compose/docker-compose is not installed')


def compose(dep, extra, check=True, capture=False):
    config_args = []
    for config in dep['configs']:
        config_args.extend(['-f', config])
    args = compose_base() + ['-p', dep['project']] + config_args + extra
    env = os.environ.copy()
    git_dir = os.path.join(dep['folder'], '.git')
    if os.path.isdir(git_dir):
        revision = run(git_args(dep['folder'], 'rev-parse', 'HEAD'), capture=True)
        epoch = run(git_args(dep['folder'], 'show', '-s', '--format=%ct', 'HEAD'), capture=True)
        dirty = run(git_args(dep['folder'], 'status', '--porcelain'), capture=True)
        if revision.returncode == 0:
            env['BUILD_REVISION'] = revision.stdout.strip()
        if epoch.returncode == 0:
            env['SOURCE_DATE_EPOCH'] = epoch.stdout.strip()
        if dirty.returncode == 0:
            env['BUILD_DIRTY'] = 'true' if dirty.stdout.strip() else 'false'
    return run(args, cwd=dep['workdir'], check=check, capture=capture, env=env)


def dotenv_value(folder, key):
    """KEY's value in folder/.env, parsed the way docker compose reads it."""
    try:
        with open(os.path.join(folder, '.env'), encoding='utf-8') as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    value = None
    for line in lines:
        line = line.strip()
        if line.startswith('export '):
            line = line[len('export '):].lstrip()
        name, sep, raw = line.partition('=')
        if not sep or name.strip() != key:
            continue
        raw = raw.strip()
        if raw[:1] in ('"', "'") and raw[0] in raw[1:]:
            raw = raw[1:raw.index(raw[0], 1)]  # quoted; anything after is a comment
        else:
            raw = raw.split(' #', 1)[0].strip()
        value = raw  # the last definition wins
    return value


def env_compose_files(folder):
    """The folder's .env COMPOSE_FILE list, resolved against the folder.

    docker compose uses it instead of its default file names whenever it runs
    in that folder without -f. This controller always passes -f, so it has to
    apply COMPOSE_FILE itself or an overlay named there would silently drop out.
    """
    raw = dotenv_value(folder, 'COMPOSE_FILE')
    if not raw:
        return None
    separator = dotenv_value(folder, 'COMPOSE_PATH_SEPARATOR') or os.pathsep
    files = [item.strip() for item in raw.split(separator) if item.strip()]
    return [os.path.abspath(os.path.join(folder, item)) for item in files] or None


def compose_files_for(workdir, raw):
    files = []
    for item in (raw or '').split(','):
        item = item.strip()
        if not item:
            continue
        path = item if os.path.isabs(item) else os.path.join(workdir, item)
        files.append(os.path.abspath(path))
    if len(files) == 1 and os.path.basename(files[0]) == 'docker-compose.yml':
        override = os.path.join(os.path.dirname(files[0]), 'docker-compose.override.yml')
        if os.path.isfile(override):
            files.append(os.path.abspath(override))
    return files


def package_root(workdir):
    workdir = os.path.abspath(workdir)
    opt = os.path.abspath(OPT_ROOT)
    if os.path.basename(workdir) == 'infra' and os.path.dirname(workdir).startswith(opt + os.sep):
        return os.path.dirname(workdir)
    return workdir


def add(deployments, alias, project, workdir, configs, source, container=None, service=None, image=None, status=None):
    if not alias or not project or not workdir or not configs:
        return
    workdir = os.path.abspath(workdir)
    configs = [os.path.abspath(c) for c in configs]
    if not os.path.isdir(workdir):
        return
    if not all(os.path.isfile(c) for c in configs):
        return
    folder = package_root(workdir)
    if not folder.startswith(os.path.abspath(OPT_ROOT) + os.sep):
        return
    key = (alias, project, workdir, tuple(configs))
    dep = deployments.setdefault(key, {
        'name': alias,
        'project': project,
        'folder': folder,
        'workdir': workdir,
        'configs': configs,
        'source': source,
        'containers': [],
        'services': set(),
        'images': set(),
        'aliases': set([alias, project, os.path.basename(folder)]),
    })
    if container:
        dep['containers'].append({'name': container, 'service': service or '', 'image': image or '', 'status': status or ''})
        dep['aliases'].add(container)
    if service:
        dep['services'].add(service)
    if image:
        dep['images'].add(image)


def discover():
    deployments = {}
    ps = run(['docker', 'ps', '-a', '--format', '{{json .}}'], capture=True)
    names = []
    for line in ps.stdout.splitlines():
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        name = item.get('Names') or item.get('Name') or ''
        if name:
            names.append(name)
    if names:
        inspected = run(['docker', 'inspect', *names], capture=True)
        if inspected.returncode == 0:
            for obj in json.loads(inspected.stdout):
                labels = (obj.get('Config') or {}).get('Labels') or {}
                project = labels.get('com.docker.compose.project')
                workdir = labels.get('com.docker.compose.project.working_dir')
                configs = compose_files_for(workdir or '', labels.get('com.docker.compose.project.config_files'))
                if not project or not workdir or not configs:
                    continue
                folder = package_root(workdir)
                alias = os.path.basename(folder)
                state_obj = obj.get('State') or {}
                state = state_obj.get('Status') or ''
                health = (state_obj.get('Health') or {}).get('Status')
                status = f'{state} ({health})' if health else state
                add(
                    deployments,
                    alias=alias,
                    project=project,
                    workdir=workdir,
                    configs=configs,
                    source='docker-label',
                    container=(obj.get('Name') or '').lstrip('/'),
                    service=labels.get('com.docker.compose.service'),
                    image=(obj.get('Config') or {}).get('Image'),
                    status=status,
                )
    opt = os.path.abspath(OPT_ROOT)
    for root, dirs, files in os.walk(opt):
        rel = os.path.relpath(root, opt)
        depth = 0 if rel == '.' else rel.count(os.sep) + 1
        if depth > 3:
            dirs[:] = []
            continue
        env_files = env_compose_files(root)
        compose_file = next((name for name in COMPOSE_NAMES if name in files), None)
        if not env_files and not compose_file:
            continue
        if env_files:
            missing = [f for f in env_files if not os.path.isfile(f)]
            if missing:
                print(f"WARNING: {os.path.join(root, '.env')} COMPOSE_FILE names missing file(s): "
                      + ', '.join(missing), file=sys.stderr)
                continue
        path = env_files[0] if env_files else os.path.abspath(os.path.join(root, compose_file))
        folder = package_root(root)
        alias = os.path.basename(folder)
        project = alias.lower()
        for dep in deployments.values():
            if dep['folder'] == folder or path in dep['configs']:
                project = dep['project']
                break
        configs = env_files or compose_files_for(root, path)
        add(deployments, alias=alias, project=project, workdir=root, configs=configs, source='opt-scan')
    result = []
    for dep in deployments.values():
        dep['services'] = sorted(dep['services'])
        dep['images'] = sorted(dep['images'])
        dep['aliases'] = sorted(a for a in dep['aliases'] if a)
        dep['containers'] = sorted(dep['containers'], key=lambda c: c['name'])
        result.append(dep)
    return sorted(result, key=lambda d: d['name'])


def canonical_name(value):
    return ''.join(char for char in value.lower() if char.isalnum())


def select(name):
    deployments = discover()

    # A source checkout often carries a standalone Compose file for running that
    # one service by itself, while the service that is actually deployed belongs
    # to a stack next to it. Route to the running owner first: `deploy EchoWeb`
    # has to mean the EchoWeb that is serving, not a second copy started from
    # the repo's own file with its own database and ports. The checkout is still
    # where the Git pull and the build happen — only the Compose project and
    # file come from the running deployment.
    requested = canonical_name(name)
    for dep in deployments:
        target_service = next(
            (service for service in dep['services'] if canonical_name(service) == requested),
            None,
        )
        if not (dep['containers'] and target_service):
            continue
        # The checkout sits either inside the stack folder (/opt/local/echo/EchoWeb)
        # or beside it (the older layout). If it *is* the stack folder, there is
        # nothing to route: the exact-name match below deploys the whole project.
        for candidate in (os.path.join(dep['workdir'], name),
                          os.path.join(os.path.dirname(dep['workdir']), name)):
            if os.path.abspath(candidate) == os.path.abspath(dep['workdir']):
                continue
            if os.path.isdir(os.path.join(candidate, '.git')):
                routed = dict(dep)
                routed['name'] = name
                routed['folder'] = os.path.abspath(candidate)
                routed['target_service'] = target_service
                return routed

    # Then exact names, the running one first for the same reason.
    exact_name_matches = [dep for dep in deployments if dep["name"] == name]
    exact_running = [dep for dep in exact_name_matches if dep["containers"]]
    if len(exact_running) == 1:
        return exact_running[0]
    if len(exact_name_matches) == 1:
        return exact_name_matches[0]
    exact_nonrunning = [dep for dep in exact_name_matches if not dep["containers"]]
    if len(exact_nonrunning) == 1:
        return exact_nonrunning[0]

    container_matches = [dep for dep in deployments if any(c["name"] == name for c in dep["containers"])]
    if len(container_matches) == 1:
        return container_matches[0]

    matches = []
    for dep in deployments:
        aliases = set(dep['aliases']) | {c['name'] for c in dep['containers']}
        if name in aliases:
            matches.append(dep)
    if not matches:
        detected = ', '.join(dep['name'] for dep in deployments) or '(none)'
        print(f"ERROR: no deployment matched '{name}'", file=sys.stderr)
        print(f'Detected names: {detected}', file=sys.stderr)
        raise SystemExit(3)
    if len(matches) > 1:
        print(f"ERROR: '{name}' matched multiple deployments: " + ', '.join(dep['name'] for dep in matches), file=sys.stderr)
        raise SystemExit(4)
    return matches[0]


def list_projects():
    data = discover()
    if not data:
        print('No deployments detected.')
        return
    print('NAME\tPROJECT\tFOLDER\tCOMPOSE\tSERVICES\tCONTAINERS')
    for dep in data:
        containers = ','.join(c['name'] for c in dep['containers']) or '-'
        services = ','.join(dep['services']) or '-'
        print(f"{dep['name']}\t{dep['project']}\t{dep['folder']}\t{','.join(dep['configs'])}\t{services}\t{containers}")


def wait_healthy(dep):
    target = dep.get('target_service')
    names = [
        c['name'] for c in dep['containers']
        if not target or c['service'] == target
    ]
    if not names:
        return True
    deadline = time.time() + 120
    while time.time() < deadline:
        ok = True
        for name in names:
            proc = run([
                'docker', 'inspect', name, '--format',
                '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.State.ExitCode}}',
            ], capture=True)
            if proc.returncode != 0:
                ok = False
                continue
            parts = proc.stdout.strip().split()
            state = parts[0] if parts else ''
            health = parts[1] if len(parts) > 1 else 'none'
            exit_code = int(parts[2]) if len(parts) > 2 else -1
            running_ok = state == 'running' and health in ('healthy', 'none')
            completed_ok = state == 'exited' and exit_code == 0
            if not (running_ok or completed_ok):
                ok = False
        if ok:
            return True
        time.sleep(2)
    return False


def status(dep):
    args = ['ps']
    if dep.get('target_service'):
        args.append(dep['target_service'])
    compose(dep, args)


def git_clean(folder, attempts=3):
    args = git_args(folder, 'status', '--porcelain', '--untracked-files=no')
    for attempt in range(1, attempts + 1):
        proc = run(args, capture=True)
        if proc.returncode == 0:
            return not proc.stdout.strip()
        if attempt < attempts:
            time.sleep(1)

    detail = (proc.stderr or proc.stdout or 'unknown Git error').strip()
    fail(f"could not inspect Git status for {folder}: {detail}")


def deploy(dep, dry=False):
    print(f"Deployment: {dep['name']}")
    print(f"Folder: {dep['folder']}")
    print(f"Compose project: {dep['project']}")
    print(f"Working dir: {dep['workdir']}")
    label = 'Compose file' if len(dep['configs']) == 1 else 'Compose files'
    print(f"{label}: {', '.join(dep['configs'])}")
    target = dep.get('target_service')
    if target:
        print(f"Service: {target}")
    if os.path.isdir(os.path.join(dep['folder'], '.git')):
        if not git_clean(dep['folder']):
            fail(f"{dep['folder']} has uncommitted changes; refusing to deploy")
        print('Git: fetch --prune origin; pull --ff-only')
        if not dry:
            run(git_args(dep['folder'], 'fetch', '--prune', 'origin'), check=True, capture=False)
            run(git_args(dep['folder'], 'pull', '--ff-only'), check=True, capture=False)
    else:
        print('Git: skipped, folder is not a git checkout.')
    print('Compose: pull --ignore-pull-failures; up -d --build')
    if dry:
        return
    pull_args = ['pull', '--ignore-pull-failures']
    up_args = ['up', '-d', '--build']
    if target:
        pull_args.append(target)
        up_args.extend(['--no-deps', '--force-recreate', target])
    compose(dep, pull_args, check=False)
    compose(dep, up_args)
    refreshed = select(sys.argv[2])
    if not wait_healthy(refreshed):
        status(refreshed)
        print('ERROR: deployment did not become healthy/running in time', file=sys.stderr)
        raise SystemExit(1)
    status(refreshed)


def main():
    if os.geteuid() != 0:
        print('ERROR: run this script with sudo', file=sys.stderr)
        raise SystemExit(2)
    action = sys.argv[1] if len(sys.argv) > 1 else 'list'
    if action == 'list':
        if len(sys.argv) != 2:
            fail('list does not take a name')
        list_projects()
        return
    if len(sys.argv) != 3:
        fail(f'{action} requires a name')
    dep = select(sys.argv[2])
    if action == 'status':
        status(dep)
    elif action == 'stop':
        args = ['stop']
        if dep.get('target_service'):
            args.append(dep['target_service'])
        compose(dep, args)
        status(dep)
    elif action == 'restart':
        args = ['restart']
        if dep.get('target_service'):
            args.append(dep['target_service'])
        compose(dep, args)
        refreshed = select(sys.argv[2])
        if not wait_healthy(refreshed):
            print('ERROR: deployment did not become healthy/running in time', file=sys.stderr)
            raise SystemExit(1)
        status(refreshed)
    elif action == 'recreate':
        args = ['up', '-d', '--build', '--force-recreate']
        if dep.get('target_service'):
            args.extend(['--no-deps', dep['target_service']])
        compose(dep, args)
        refreshed = select(sys.argv[2])
        if not wait_healthy(refreshed):
            print('ERROR: deployment did not become healthy/running in time', file=sys.stderr)
            raise SystemExit(1)
        status(refreshed)
    elif action == 'deploy':
        deploy(dep, dry=False)
    elif action == 'dry-run':
        deploy(dep, dry=True)
    else:
        fail(f"unknown action '{action}'")


if __name__ == '__main__':
    main()
